@article{ WOS:001641902700001,
Author = {He, Zhe and Pang, Yuanying and von Hollen, Lucas and Castano, Marcela
   and Kinsell, Heidi and Adams, Jonathan and Roberson, Keith and Born,
   Patricia and Miao, Hongyu},
Title = {Usability and Acceptance of In-app Social-interacting Features for
   Promoting Adherence To Computerized Cognitive Training: a Pilot
   Evaluation},
Journal = {JOURNAL OF COGNITIVE ENHANCEMENT},
Year = {2025},
Volume = {9},
Number = {4},
Pages = {439-454},
Month = {DEC},
Abstract = {As the aging population grows, cognitive decline and dementia may pose
   more significant public health challenges. Non-pharmacologic
   interventions, including cognitive training, offer potential solutions
   to mitigate cognitive deterioration; however, intervention adherence
   remains a key challenge. This pilot study examines the impact of social
   interaction features on adherence to cognitive training among older
   adults using the Mind Frontier software, a gamified cognitive training
   program. This study aimed to evaluate whether the integration of a
   leaderboard and chat system is associated with self-perceived social
   connectiveness (measured by a loneliness scale), adherence to and
   self-perceived efficacy in cognitive training, and the usability of the
   cognitive training system. A single-group pre-post design was employed,
   involving 24 participants aged 65 and older who completed a four-week
   intervention. Participants were provided with a tablet-based training
   system and were instructed to complete cognitive training sessions three
   days per week. Adherence metrics, usability ratings, and social
   engagement data were collected. Results indicated that while most
   participants maintained minimal adherence throughout the intervention,
   adherence levels declined over time. Frequent users of the chat and
   leaderboard functions rated the system more favorably but did not show
   significantly higher adherence compared to infrequent users.
   Additionally, a slight increase in loneliness and a decrease in
   self-efficacy were observed post-training, suggesting the need for
   enhanced support and interactive features. Correlation analysis revealed
   that higher adherence was associated with decreased loneliness, and
   participants with higher post-training self-efficacy gave better
   usability ratings. This study highlights the potential of integrating
   social interaction into cognitive training programs to promote
   adherence, while also underscoring the challenges of maintaining
   long-term adherence. Future research should investigate strategies to
   sustain engagement in technology-based cognitive interventions for older
   adults.},
