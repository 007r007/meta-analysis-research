@article{ WOS:000416286200002,
Author = {Soveri, Anna and Karlsson, Eric P. A. and Waris, Otto and
   Gronholm-Nyman, Petra and Laine, Matti},
Title = {Pattern of Near Transfer Effects Following Working Memory Training With
   a Dual \&ITN\&IT-Back Task},
Journal = {EXPERIMENTAL PSYCHOLOGY},
Year = {2017},
Volume = {64},
Number = {4},
Pages = {240-252},
Month = {JUL},
Abstract = {In a randomized controlled trial, we investigated the pattern of near
   transfer effects of working memory (WM) training with an adaptive
   auditory-visuospatial dual n-back training task in healthy young adults.
   The results revealed significant task-specific transfer to an untrained
   single n-back task, and more general near transfer to a WM updating
   composite score plus a nearly significant effect on a composite score
   measuring interference control in WM. No transfer effects were seen on
   Active or Passive WM composites. The results are discussed in the light
   of cognitive versus strategy-related overlap between training and
   transfer tasks.},
