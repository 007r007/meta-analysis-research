@article{ WOS:000344874900006,
Author = {Karbach, Julia and Verhaeghen, Paul},
Title = {Making Working Memory Work: A Meta-Analysis of Executive-Control and
   Working Memory Training in Older Adults},
Journal = {PSYCHOLOGICAL SCIENCE},
Year = {2014},
Volume = {25},
Number = {11},
Pages = {2027-2037},
Month = {NOV},
Abstract = {This meta-analysis examined the effects of process-based
   executive-function and working memory training (49 articles, 61
   independent samples) in older adults (> 60 years). The interventions
   resulted in significant effects on performance on the trained task and
   near-transfer tasks; significant results were obtained for the net
   pretest-to-posttest gain relative to active and passive control groups
   and for the net effect at posttest relative to active and passive
   control groups. Far-transfer effects were smaller than near-transfer
   effects but were significant for the net pretest-to-posttest gain
   relative to passive control groups and for the net gain at posttest
   relative to both active and passive control groups. We detected
   marginally significant differences in training-induced improvements
   between working memory and executive-function training, but no
   differences between the training-induced improvements observed in older
   adults and younger adults, between the benefits associated with adaptive
   and nonadaptive training, or between the effects in active and passive
   control conditions. Gains did not vary with total training time.},
