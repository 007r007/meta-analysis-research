@article{ WOS:000306714600005,
Author = {Unverzagt, Frederick W. and Guey, Lin T. and Jones, Richard N. and
   Marsiske, Michael and King, Jonathan W. and Wadley, Virginia G. and
   Crowe, Michael and Rebok, George W. and Tennstedt, Sharon L.},
Title = {ACTIVE Cognitive Training and Rates of Incident Dementia},
Journal = {JOURNAL OF THE INTERNATIONAL NEUROPSYCHOLOGICAL SOCIETY},
Year = {2012},
Volume = {18},
Number = {4},
Pages = {669-677},
Month = {JUL},
Abstract = {Systematic cognitive training produces long-term improvement in
   cognitive function and less difficulty in performing activities of daily
   living. We examined whether cognitive training was associated with
   reduced rate of incident dementia. Participants were from the Advanced
   Cognitive Training for Independent and Vital Elderly (ACTIVE) study (n =
   2,802). Incident dementia was defined using a combination of interview-
   and performance-based methods. Survival analysis was used to determine
   if ACTIVE treatment affected the rate of incident dementia during 5
   years of follow-up. A total of 189 participants met criteria for
   incident dementia. Baseline factors predictive of incident dementia were
   older age, male gender, African American race, fewer years of education,
   relationship other than married, no alcohol use, worse MMSE, worse SF-36
   physical functioning, higher depressive symptomatology, diabetes, and
   stroke (all p < .05). A multivariable model with significant predictors
   of incident dementia and training group revealed that cognitive training
   was not associated with a lower rate of incident dementia. Cognitive
   training did not affect rates of incident dementia after 5 years of
   follow-up. Longer follow-up or enhanced training may be needed to fully
   explore the preventive capacity of cognitive training in forestalling
   onset of dementia. (JINS, 2012, 18, 669-677)},
