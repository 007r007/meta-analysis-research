Month = {JUL},
Abstract = {This article reports on a study that investigated the role of cognitive
   resources in the everyday functioning of 121 older adults who were
   visually impaired and 150 sighted older adults, with a mean age of 82
   years. Cognitive performance and everyday functioning were most strongly
   related in the group who were visually impaired. The authors conclude
   that cognitive training enhances independent living skills.},
