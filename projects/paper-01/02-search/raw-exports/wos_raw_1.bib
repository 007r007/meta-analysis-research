@article{ WOS:000834873200001,
Author = {Studer-Luethi, Barbara and Boesch, Valerie and Lusti, Simon and Meier,
   Beat},
Title = {Fostering cognitive performance in older adults with a process- and a
   strategy-based cognitive training},
Journal = {AGING NEUROPSYCHOLOGY AND COGNITION},
Year = {2023},
Volume = {30},
Number = {5},
Pages = {837-859},
Month = {SEP 3},
Abstract = {The present study investigates the impact of process-based and
   strategy-based cognitive training to boost performance in healthy older
   adults. Three groups trained with either a dichotic listening training
   (process-based training, n = 25), an implementation intention strategy
   training (strategy-based training, n = 23), or served as a non-contact
   control group (n = 30). Our results demonstrated that training
   participants improved their performance in the trained tasks
   (process-based training: d = 3.01, strategy-based training: d = 2.6).
   For untrained tasks, the process-based training group showed significant
   working memory (d = .58) as well as episodic memory task improvement (d
   = 1.19) compared to the strategy-based training and to the non-contact
   control group (all d < .03). In contrast, in the strategy-based training
   group there was a tendency towards some performance gain in a fluid
   intelligence test (d = .92). These results indicate that cognitive
   training can be tailored to improve specific cognitive abilities.},
