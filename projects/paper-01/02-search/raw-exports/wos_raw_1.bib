@article{ WOS:000417902800006,
Author = {Guye, Sabrina and von Bastian, Claudia C.},
Title = {Working Memory Training in Older Adults: Bayesian Evidence Supporting
   the Absence of Transfer},
Journal = {PSYCHOLOGY AND AGING},
Year = {2017},
Volume = {32},
Number = {8},
Pages = {732-746},
Month = {DEC},
Note = {Conference of the European-Society-for-Cognitive-Psychology, Potsdam,
   GERMANY, 2017},
Organization = {European Soc Cognit Psychol},
Abstract = {The question of whether working memory training leads to generalized
   improvements in untrained cognitive abilities is a longstanding and
   heatedly debated one. Previous research provides mostly ambiguous
   evidence regarding the presence or absence of transfer effects in older
   adults. Thus, to draw decisive conclusions regarding the effectiveness
   of working memory training interventions, methodologically sound studies
   with larger sample sizes are needed. In this study, we investigated
   whether or not a computer-based working memory training intervention
   induced near and far transfer in a large sample of 142 healthy older
   adults (65 to 80 years). Therefore, we randomly assigned participants to
   either the experimental group, which completed 25 sessions of adaptive,
   process-based working memory training, or to the active, adaptive visual
   search control group. Bayesian linear mixed-effects models were used to
   estimate performance improvements on the level of abilities, using
   multiple indicator tasks for near (working memory) and far transfer
   (fluid intelligence, shifting, and inhibition). Our data provided
   consistent evidence supporting the absence of near transfer to untrained
   working memory tasks and the absence of far transfer effects to all of
   the assessed abilities. Our results suggest that working memory training
   is not an effective way to improve general cognitive functioning in old
   age.},
