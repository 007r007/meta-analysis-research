@article{ WOS:001145361100001,
Author = {Silva, A. F. and Silva, Rui Miguel and Murawska-Cialowicz, E. and Zurek,
   G. and Danek, N. and Cialowicz, M. and Carvalho, J. and Clemente, F. M.},
Title = {Cognitive Training with Older Adults Using Smartphone and Web-Based
   Applications: A Scoping Review},
Journal = {JPAD-JOURNAL OF PREVENTION OF ALZHEIMERS DISEASE},
Year = {2024},
Volume = {11},
Number = {2},
Pages = {356-365},
Month = {MAR},
Abstract = {IntroductionThe present scoping review focused on: i) which apps were
   previously studied; ii) what is the most common frequency for
   implementing cognitive training; and iii) what cognitive functions the
   interventions most focus on.MethodsPRISMA guidelines were followed, and
   the search was conducted on Web of Science, PsycInfo, Cochrane, and
   Pubmed. From 1733 studies found, 34 were included.Resultsit was
   highlighted the necessity for forthcoming investigations to tackle the
   methodical restrictions and disparities in the domain.Discussiongreat
   diversity in intervention protocols was found. Incorporating evaluations
   of physical fitness in conjunction with cognitive evaluations can offer
   a more all-encompassing comprehension of the impacts of combined
   interventions. Furthermore, exploring the efficacy of cognitive training
   applications requires additional scrutiny, considering individual
   variances and practical outcomes in real-life settings.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
