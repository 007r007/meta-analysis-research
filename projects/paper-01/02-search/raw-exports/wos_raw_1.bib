@article{ WOS:000395555600007,
Author = {Parisi, Jeanine M. and Gross, Alden L. and Marsiske, Michael and Willis,
   Sherry L. and Rebok, George W.},
Title = {Control Beliefs and Cognition Over a 10-Year Period: Findings From the
   ACTIVE Trial},
Journal = {PSYCHOLOGY AND AGING},
Year = {2017},
Volume = {32},
Number = {1},
Pages = {69-75},
Month = {FEB},
Abstract = {We examined two facets of control beliefs and cognition over 10 years
   within the Advanced Cognitive Training for Independent and Vital Elderly
   study. Intellectual Self-Efficacy decreased (beta = -0.32 units/year; SE
   = 0.03) and Concern About Intellectual Aging increased (beta = 0.26
   units/year; SE = 0.02) over time, with older age being the only
   predictor of increases in Concern About Intellectual Aging. Although
   baseline cognitive performance was related to control beliefs over time,
   the reverse was not supported. Findings were not altered by
   participation in the ACTIVE training programs, suggesting the need for
   including intervention components that lead to long-term maintenance or
   improvements in such beliefs.},
