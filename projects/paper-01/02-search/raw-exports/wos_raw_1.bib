@article{ WOS:001527446600001,
Author = {Ihara, Emily S. and Kang, Hyun and Tompkins, Catherine. J. and Keesee,
   Francesca A. and Lauber, McKenzie S. and Hardy, Gergana N. and Magee,
   Catherine M. and Barrett, Kendall and Holden, Madeline and Pantleay,
   Harveen},
Title = {Can brain exercises mitigate cognitive decline? A quasi-experimental
   evaluation of the StrongerMemory program},
Journal = {EDUCATIONAL GERONTOLOGY},
Year = {2025},
Month = {2025 JUL 12},
Abstract = {The StrongerMemory program, a structured intervention involving reading
   aloud, writing by hand, and completing simple math problems, is designed
   to stimulate the prefrontal cortex and enhance cognitive functioning.
   This study addresses a research gap by evaluating a multi-modal
   cognitive intervention compared to traditional single-domain approaches.
   It aligns with emerging frameworks emphasizing population-informed,
   personalized cognitive training. A 12-week quasi-experimental study was
   conducted with 102 older adults (aged 59+) from three continuing care
   retirement communities (CCRCs) and 25 aging-in-place villages. Pre- and
   post-intervention cognitive outcomes were assessed using the 5-minute
   protocol of the Montreal Cognitive Assessment 2.1 (Mini MoCA) and the
   Memory Functioning Questionnaire (MFQ). ANCOVA controlled for baseline
   Mini MoCA differences. Weekly check-ins were used to monitor adherence.
   Mini MoCA scores improved from pretest (12.73 +/- 2.1) to posttest
   (13.26 +/- 2.3, p <.0001) with statistically significant recall
   improvement (3.44 to 3.92, p < .001). One MFQ item measuring perceived
   memory decline in the last year improved from pre to post (3.72 to 4.03,
   p < .001). ANCOVA indicated significantly lower post-intervention Mini
   MoCA scores among CCRC residents compared to those living in the
   community. Participation in StrongerMemory was associated with both
   objective and subjective improvement in cognitive functioning,
   especially for those living in the community. This low-cost,
   non-pharmacological program offers promise as a scalable intervention
   for cognitive aging. Differences across living environments suggest that
   social or contextual influences warrant further investigation.},
