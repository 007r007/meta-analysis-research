   Carlsson, Roger; Terjestam, Yvonne; Mohammed, Abdul Kadir H., Linnaeus Univ, Dept Psychol, Vaxjo, Sweden.
   Kidane, Mhretab, Linnaeus Univ, Dept Comp Sci \& Media Technol, Vaxjo, Sweden.
   Columbo, Laura; Granholm, Ann-Charlotte, Med Univ South Carolina, Dept Neurosci, Charleston, SC 29425 USA.
   Ryan, Eliza; Tusch, Erich; Daffner, Kirk, Harvard Med Sch, Brigham \& Womens Hosp, Dept Neurol, Boston, MA 02115 USA.
   Hakansson, Krister; Winblad, Bengt; Granholm, Ann-Charlotte; Mohammed, Abdul Kadir H., Karolinska Inst, Dept Neurobiol Care Sci \& Soc NVS, Stockholm, Sweden.},
DOI = {10.3233/JAD-190756},
