Address = {AVENUE DU TRIBUNAL FEDERAL 34, LAUSANNE, CH-1015, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Luo, C (Corresponding Author), Univ Elect Sci \& Technol China, Sch Life Sci \& Technol, High Field Magnet Resonance Brain Imaging Key Lab, Key Lab NeuroInformat,Minist Educ,Ctr Informat Me, Chengdu 610054, Peoples R China.
