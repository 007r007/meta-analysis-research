@article{ WOS:000513991600001,
Author = {Kouzuki, Minoru and Kato, Toshiaki and Wada-Isoe, Kenji and Takeda,
   Shinya and Tamura, Atsuhito and Takanashi, Yuichi and Azumi, Shintaro
   and Kojima, Yoshinori and Maruyama, Chikako and Hayashi, Maki and Itou,
   Michimi and Urakami, Katsuya},
Title = {A program of exercise, brain training, and lecture to prevent cognitive
   decline},
Journal = {ANNALS OF CLINICAL AND TRANSLATIONAL NEUROLOGY},
Year = {2020},
Volume = {7},
Number = {3},
Pages = {318-328},
Month = {MAR},
Abstract = {Objective We examined the benefits of a community-based program
   combining physical exercise, cognitive training, and education on
   dementia and lifestyle habits.
   Methods This crossover open-label trial included 141 community-dwelling
   elderly people with suspected mild cognitive decline (MCD). Subjects
   were assigned to a 6-month intervention-first/6-month observation-second
   (INT-OBS) group or an OBS-INT group. The 6-month intervention consisted
   of 2 h of physical exercise, cognitive training, and classroom study or
   rest once weekly. Primary outcome was change in Touch Panel-type
   Dementia Assessment Scale (TDAS) score.
   Results TDAS score improved significantly during the intervention period
