@article{ WOS:001594558300001,
Author = {Liu, Peirong},
Title = {Modern AI program Chinese choral arts: cognitive training and motivation
   of college choristers},
Journal = {INTERACTIVE LEARNING ENVIRONMENTS},
Year = {2025},
Month = {2025 OCT 15},
Abstract = {University and college choirs represent a rich tradition of choral
   singing that reflects China's cultural heritage. The purpose of this
   study is to analyze the traditions, styles, genres, and current trends
   of Chinese choral art, as well as to study the impact of using
   artificial intelligence technologies on the development of cognitive
   skills and motivation of choir students before and after training. The
   study involved 60 students (40 women and 20 men) aged 20-25. In order to
   evaluate the effectiveness of applied student motivation methods, the
   authors conducted a training in which different choral groups studied
   according to different learning strategies. The results of the ANOVA
   confirm the existence of statistically significant differences between
   the control and experimental groups after the training intervention.
   This indicates the effectiveness of the innovative program, which
   involved the use of AI, in the development of key cognitive functions.
   In addition, the students of the experimental group were motivated to
   create choral improvisations. The results obtained can be used in the
   professional training of choirmasters, in the extracurricular work of
   vocal groups, in inclusive music education, and in the implementation of
   distance forms of choral education.},
