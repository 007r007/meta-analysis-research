@article{ WOS:001041938200001,
Author = {Robledo-Castro, Carolina and Hederich-Martinez, Christian and
   Castillo-Ossa, Luis F.},
Title = {Cognitive stimulation of executive functions through computational
   thinking},
Journal = {JOURNAL OF EXPERIMENTAL CHILD PSYCHOLOGY},
Year = {2023},
Volume = {235},
Month = {NOV},
Abstract = {The healthy development of cognitive functions, including execu-tive
   functions, has been shown to depend mainly on the experi-ences and
   learning opportunities of people, especially during childhood. Over the
   past few years, researchers have been studying the impacts of diverse
   types of interventions on children's cogni-tive development in which
   computational thinking programs are a recent field. This pilot study
   evaluated the effect of computa-tional thinking training based on the
   ``Programming for Children{''} program on the executive functions of
   children aged 10 and 11 years: working memory, inhibition, and planning
   (N = 30). The results showed that children in the experimental group
   improved on tests of visuospatial working memory, cognitive inhi-bition,
   and sequential planning compared with the control group. However, tests
   of verbal working memory, memory strategy, and visual spatial planning
   did not show any observed changes. Although this was an exploratory
   study, and its findings should be interpreted cautiously due to the
   small sample size, the findings support the relevance and feasibility of
   conducting similar larger studies with larger samples.\& COPY; 2023 The
   Author(s). Published by Elsevier Inc. This is an open access article
   under the CC BY-NC-ND license
   (http://creativecom-mons.org/licenses/by-nc-nd/4.0/).},
