@article{ WOS:000485100900008,
Author = {Shema-Shiratzky, Shirley and Brozgol, Marina and Cornejo-Thumm, Pablo
   and Geva-Dayan, Karen and Rotstein, Michael and Leitner, Yael and
   Hausdorff, Jeffrey M. and Mirelman, Anat},
Title = {Virtual reality training to enhance behavior and cognitive function
   among children with attention-deficit/hyperactivity disorder: brief
   report},
Journal = {DEVELOPMENTAL NEUROREHABILITATION},
Year = {2019},
Volume = {22},
Number = {6},
Pages = {431-436},
Month = {AUG 18},
Abstract = {Purpose: To examine the feasibility and efficacy of a combined
   motor-cognitive training using virtual reality to enhance behavior,
   cognitive function and dual-tasking in children with
   Attention-Deficit/Hyperactivity Disorder (ADHD).Methods: Fourteen
   non-medicated school-aged children with ADHD, received 18 training
   sessions during 6weeks. Training included walking on a treadmill while
   negotiating virtual obstacles. Behavioral symptoms, cognition and gait
   were tested before and after the training and at 6-weeks
   follow-up.Results: Based on parental report, there was a significant
   improvement in children's social problems and psychosomatic behavior
   after the training. Executive function and memory were improved
   post-training while attention was unchanged. Gait regularity
   significantly increased during dual-task walking. Long-term training
   effects were maintained in memory and executive function.Conclusion:
   Treadmill-training augmented with virtual-reality is feasible and may be
   an effective treatment to enhance behavior, cognitive function and
   dual-tasking in children with ADHD.},
Publisher = {TAYLOR \& FRANCIS INC},
Address = {530 WALNUT STREET, STE 850, PHILADELPHIA, PA 19106 USA},
Type = {Article},
