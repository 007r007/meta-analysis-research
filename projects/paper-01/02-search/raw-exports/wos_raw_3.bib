@article{ WOS:000471133600009,
Author = {Kulmala, Jenni and Ngandu, Tiia and Havulinna, Satu and Levalahti, Esko
   and Lehtisalo, Jenni and Solomon, Alina and Antikainen, Riitta and
   Laatikainen, Tiina and Pippola, Pauliina and Peltonen, Markku and
   Rauramaa, Rainer and Soininen, Hilkka and Strandberg, Timo and
   Tuomilehto, Jaakko and Kivipelto, Miia},
Title = {The Effect of Multidomain Lifestyle Intervention on Daily Functioning in
   Older People},
Journal = {JOURNAL OF THE AMERICAN GERIATRICS SOCIETY},
Year = {2019},
Volume = {67},
Number = {6},
Pages = {1138-1144},
Month = {JUN},
Abstract = {OBJECTIVE To investigate the effect of a 2-year multidomain lifestyle
   intervention on daily functioning of older people. DESIGN A 2-year
   randomized controlled trial (, NCT01041989). SETTING Finnish Geriatric
   Intervention Study to Prevent Cognitive Impairment and Disability.
   PARTICIPANTS A total of 1260 older adults, with a mean age of 69 years
   at the baseline, who were at risk of cognitive decline. INTERVENTION A
   multidomain intervention, including simultaneous physical activity
   intervention, nutritional counseling, vascular risk monitoring and
   management, and cognitive training and social activity. MEASUREMENTS The
   ability to perform daily activities (activities of daily living {[}ADLs]
   and instrumental ADLs) and physical performance (Short Physical
   Performance Battery). RESULTS The mean baseline ADL score was 18.1 (SD =
   2.6) points; the scale ranges from 17 (no difficulties) to 85 (total ADL
   dependence). During the 2-year intervention, the ADL disability score
   slightly increased in the control group, while in the intervention
   group, it remained relatively stable. Based on the latent growth curve
   model, the difference in the change between the intervention and control
   groups was -0.95 (95\% confidence interval {[}CI] = -1.61 to -0.28)
   after 1 year and -1.20 (95\% CI = -2.02 to -0.38) after 2 years. In
   terms of physical performance, the intervention group had a slightly
   higher probability of improvement (from score 3 to score 4; P = .041)
   and a lower probability of decline (from score 3 to scores 0-2; P =
   .043) for chair rise compared to the control group. CONCLUSION A 2-year
   lifestyle intervention was able to maintain the daily functioning of the
   at-risk older population. The clinical significance of these results in
   this fairly well-functioning population remains uncertain, but the study
   results hold promise that healthy eating, exercise, and cognitive and
   social activity may have favorable effects on functional independence in
   older people.},
