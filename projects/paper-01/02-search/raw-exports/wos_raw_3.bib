@article{ WOS:001536349000001,
Author = {Sindhu, P. and Tanuja, M. N. and Shetty, Hemanth Narayan and Devi, N.},
Title = {Development and Content Validation of Auditory and Auditory-Cognitive
   Training Manual in Kannada Language for Children with Central Auditory
   Processing Disorder},
Journal = {INDIAN JOURNAL OF OTOLARYNGOLOGY AND HEAD \& NECK SURGERY},
Year = {2025},
Volume = {77},
Number = {11},
Pages = {4833-4844},
Month = {NOV},
Abstract = {Various auditory training benefits children with Central Auditory
   Processing Disorder, but these training manual are not region or
   language-specific. There is no training manual in Kannada language
   emphasis on auditory and auditory-cognitive skills. The objective is (a)
   to ascertain content validation from experts using data reduction
   strategy for the levels within each module and (b) to explore the
   content validation process focusing on auditory and auditory-cognitive
   abilities among children aged 8-12 with Central Auditory Processing
   Disorder. The training manual comprised two modules: an auditory and an
   auditory-cognitive module. Each module consists of different subchapters
   and levels. A data reduction strategy was adapted to select sublevels in
   each module for content validation. A total of five experts were
   involved in the judgment of each of the training items. The content
   validity index and kappa coefficient were assessed to check the
   reliability of the expert judgment. Experts have recommended content
   validation for 12 levels within the auditory module and one subchapter
   in the auditory-cognitive module, prioritizing those with Eigen values >
   1 as indicated by principal component analysis. A total of 83 items were
   excluded from 1332 items, with a focus on maintaining a high Content
   Validity Index (CVI) = (> 0.75), Item-level Content validity Index based
   on universal agreement (ICVI/UA) = (> 0.40), and Kappa coefficient = 1.
   The developed training manual incorporated age-appropriate and familiar
   manual, were guided by expert evaluation, and underwent a thorough
   content validation process.},
